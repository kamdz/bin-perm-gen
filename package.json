{
  "name": "bin-perm-gen",
  "version": "1.0.6",
  "description": "Generate binary permutations with customizable formats and filters. Lightweight, zero-dependency and lazy, using generators.",
  "keywords": [
    "binary permutations",
    "boolean permutations",
    "permutations",
    "combinations",
    "generator"
  ],
  "homepage": "https://github.com/kamdz/bin-perm-gen#readme",
  "bugs": {
    "url": "https://github.com/kamdz/bin-perm-gen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdz/bin-perm-gen.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kamil Dzwonkowski",
    "email": "npm@kamdz.dev",
    "url": "https://github.com/kamdz"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bin-perm-gen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "cli": "node src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
